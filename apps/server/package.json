{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc -p .",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "replay": "node scripts/replay.mjs",
    "start": "prisma migrate deploy && tsx prisma/seed.ts && tsx src/index.ts"
  },
  "dependencies": {
    "@d11/shared": "workspace:^",
    "@fastify/static": "^8",
    "@prisma/client": "^6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "livekit-server-sdk": "^2.19.3",
    "prisma": "^6",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "~5.9"
  }
}
